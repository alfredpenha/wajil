---
import Card from '../ui/Card.astro';

const { faq } = Astro.props;
---
{faq ? (
  <section id="faq" class="section-x border-t border-fog/10 py-16">
    <div class="section-inner">
      <h2 class="section-title mb-6">{faq.title}</h2>
      <div class="grid gap-3 md:grid-cols-2">
        {faq.items.map((item) => (
          <details class="group rounded-card border border-fog/15 bg-ink/70 p-4 transition hover:border-fog/30">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-sand">
              <span>{item.question}</span>
              <span class="text-gold/70 transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-sm text-sand/80">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
) : null}
