---
import '../styles/global.css';
import { site } from '../content/site';
import { withBase } from '../lib/images';
import { resolveAnalyticsConfig } from '../lib/analytics-config';
import AnalyticsProvider from '../components/analytics/AnalyticsProvider.astro';

const analyticsConfig = resolveAnalyticsConfig(site.meta.domain);
const heroPreload = Astro.props.heroPreload ?? null;
const jsonLd = Astro.props.jsonLd ?? null;

const pageTitle = Astro.props.title
  ? `${Astro.props.title} - ${site.brand.name}`
  : site.meta.title;
const pageDescription = Astro.props.description ?? site.meta.description;
const siteUrl = site.meta.url ?? `https://${site.meta.domain}`;
const ogImage = site.meta.ogImage ?? '/assets/images/img1-hero-16x9.jpg';
const ogImageAlt = site.meta.ogImageAlt ?? site.brand.name;
const ogImagePath = withBase(ogImage);
const ogImageUrl = ogImagePath.startsWith('http') ? ogImagePath : new URL(ogImagePath, siteUrl).toString();
const favicon = withBase(site.meta.favicon);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#080808" />
    <title>{pageTitle}</title>
    <link rel="icon" href={favicon} />
    <link rel="canonical" href={Astro.url} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Sora:wght@400;600&display=swap"
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand.name} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {heroPreload?.desktop ? (
      <link rel="preload" as="image" href={heroPreload.desktop} media="(min-width: 768px)" />
    ) : null}
    {heroPreload?.mobile ? (
      <link rel="preload" as="image" href={heroPreload.mobile} media="(max-width: 767px)" />
    ) : null}

    {jsonLd ? (
      <script type="application/ld+json">{JSON.stringify(jsonLd)}</script>
    ) : null}

    <AnalyticsProvider placement="head" config={analyticsConfig} />
  </head>
  <body class="bg-ink text-sand">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <AnalyticsProvider placement="body" config={analyticsConfig} />
    <script is:inline define:vars={{ provider: analyticsConfig.provider, ga4Id: analyticsConfig.ga4Id, gtmId: analyticsConfig.gtmId }}>
      window.__trackEvent = function(name, props) {
        if (!name) return;

        if (provider === 'plausible') {
          const plausible = window.plausible;
          if (typeof plausible === 'function') {
            plausible(name, props ? { props: props } : undefined);
          }
          return;
        }

        if (provider === 'ga4') {
          const gtag = window.gtag;
          if (typeof gtag === 'function') {
            gtag('event', name, props || {});
          }
          return;
        }

        if (provider === 'gtm') {
          const dataLayer = window.dataLayer;
          if (Array.isArray(dataLayer)) {
            dataLayer.push(Object.assign({ event: name }, props || {}));
          } else {
            window.dataLayer = [Object.assign({ event: name }, props || {})];
          }
        }
      };
    </script>
    <slot />
  </body>
</html>
